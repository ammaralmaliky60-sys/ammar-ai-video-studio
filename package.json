{
  "name": "khaybar-video-system",
  "private": true,
  "version": "0.1.0",
  "description": "KHAYBAR 2.0 — Remotion video system (logo outro first).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:outro": "remotion render src/index.ts KhaybarOutro exports/video/khaybar-outro.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --muted --browser-executable=$PW_CHROME",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.5",
    "@fontsource/noto-kufi-arabic": "5.2.5",
    "@remotion/cli": "4.0.541",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}

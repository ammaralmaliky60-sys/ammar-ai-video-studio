 ],
 "lines": [
  {
   "ch": "CH01",
   "s": 0,
   "e": 135,
   "text": "تخيّل لو كل عذر گُلته بحياتك… صار دليل ضدّك."
  },
  {
   "ch": "CH01",
   "s": 135,
   "e": 261,
   "text": "وكل موقف حاولت تنساه… رجع حتى يشهد عليك."
  },
  {
   "ch": "CH01",
   "s": 261,
   "e": 364,
   "text": "وفجأة، تلگه نفسك واقف بمحكمة غريبة."
  },
  {
   "ch": "CH01",
   "s": 364,
   "e": 409,
   "text": "ما تعرف منو جابك."
  },
  {
   "ch": "CH01",
   "s": 409,
   "e": 467,
   "text": "ولا تعرف شنو التهمة."
  },
  {
   "ch": "CH01",
   "s": 467,
   "e": 502,
   "text": "القاضي ساكت…"
  },
  {
   "ch": "CH01",
   "s": 502,
   "e": 566,
   "text": "والشاهد ينتظر دوره…"
  },
  {
   "ch": "CH01",
   "s": 566,
   "e": 629,
   "text": "والأدلة كلها موجودة."
  },
  {
   "ch": "CH01",
   "s": 629,
   "e": 727,
   "text": "تحاول تتذكّر شنو سويت حتى وصلت لهنا."
  },
  {
   "ch": "CH01",
   "s": 727,
   "e": 770,
   "text": "بس الغريب بالموضوع…"
  },
  {
   "ch": "CH01",
   "s": 770,
   "e": 865,
   "text": "إنك تعرف هاي المحكمة أكثر مما تتصور."
  },
  {
   "ch": "CH02",
   "s": 920,
   "e": 964,
   "text": "تبدأ المحاكمة…"
  },
  {
   "ch": "CH02",
   "s": 964,
   "e": 1008,
   "text": "ويطلع أول دليل."
  },
  {
   "ch": "CH02",
   "s": 1008,
   "e": 1099,
   "text": "ذاك اليوم اللي جرحت بيه إنسان بكلمة."
  },
  {
   "ch": "CH02",
   "s": 1099,
   "e": 1131,
   "text": "تتذكره؟"
  },
  {
   "ch": "CH02",
   "s": 1131,
   "e": 1182,
   "text": "إنت گُلت: چنت معصّب."
  },
  {
   "ch": "CH02",
   "s": 1182,
   "e": 1236,
   "text": "ويطلع دليل ثاني…"
  },
  {
   "ch": "CH02",
   "s": 1236,
   "e": 1316,
   "text": "موقف چنت تعرف بيه الحق، بس سكتّ."
  },
  {
   "ch": "CH02",
   "s": 1316,
   "e": 1378,
   "text": "گُلت: ما چنت أريد مشاكل."
  },
  {
   "ch": "CH02",
   "s": 1378,
   "e": 1420,
   "text": "ودليل ثالث…"
  },
  {
   "ch": "CH02",
   "s": 1420,
   "e": 1479,
   "text": "حچيت على إنسان بغيابه."
  },
  {
   "ch": "CH02",
   "s": 1479,
   "e": 1563,
   "text": "گُلت: مو بس آني… الكل چان يحچي."
  },
  {
   "ch": "CH02",
   "s": 1563,
   "e": 1677,
   "text": "وكل مرة تقدم عذر، تحس إنك نجحت بالدفاع عن نفسك."
  },
  {
   "ch": "CH02",
   "s": 1677,
   "e": 1817,
   "text": "بس ما تنتبه إن كل عذر من هاي الأعذار، دا يبني جدار حواليك."
  },
  {
   "ch": "CH02",
   "s": 1817,
   "e": 1866,
   "text": "حجر فوق حجر…"
  },
  {
   "ch": "CH02",
   "s": 1866,
   "e": 1998,
   "text": "لحد ما يصير دفاعك عن نفسك، هو السجن اللي حابس نفسك بيه."
  },
  {
   "ch": "CH03",
   "s": 2064,
   "e": 2141,
   "text": "بس أكو حقيقة ما تگدر تهرب منها."
  },
  {
   "ch": "CH03",
   "s": 2141,
   "e": 2195,
   "text": "القرآن الكريم يگول:"
  },
  {
   "ch": "CH03",
   "s": 2215,
   "e": 2383,
   "text": "بَلِ الْإِنسَانُ عَلَىٰ نَفْسِهِ بَصِيرَةٌ، وَلَوْ أَلْقَىٰ مَعَاذِيرَهُ."
  },
  {
   "ch": "CH03",
   "s": 2408,
   "e": 2444,
   "text": "تأمّل هاي الآية."
  },
  {
   "ch": "CH03",
   "s": 2461,
   "e": 2513,
   "text": "ممكن تقنع الناس بعذرك."
  },
  {
   "ch": "CH03",
   "s": 2513,
   "e": 2621,
   "text": "ممكن ترتّب كلامك حتى تطلع إنت المظلوم."
  },
  {
   "ch": "CH03",
   "s": 2621,
   "e": 2748,
   "text": "وممكن تخفي جزء من الحقيقة، حتى تحافظ على صورتك گدامهم."
  },
  {
   "ch": "CH03",
   "s": 2748,
   "e": 2801,
   "text": "بس بينك وبين نفسك…"
  },
  {
   "ch": "CH03",
   "s": 2801,
   "e": 2848,
   "text": "إنت تعرف شنو صار."
  },
  {
   "ch": "CH03",
   "s": 2848,
   "e": 2902,
   "text": "وتعرف شنو چان قصدك."
  },
  {
   "ch": "CH03",
   "s": 2902,
   "e": 3043,
   "text": "وتعرف الفرق بين السبب الحقيقي، والعذر اللي اخترعته حتى ترتاح."
  },
  {
   "ch": "CH03",
   "s": 3043,
   "e": 3155,
   "text": "المشكلة مو دائماً إنك ما تعرف الحقيقة."
  },
  {
   "ch": "CH03",
   "s": 3155,
   "e": 3287,
   "text": "أحياناً، المشكلة إنك تعرفها… وما تريد تواجهها."
  },
  {
   "ch": "CH04",
   "s": 3339,
   "e": 3371,
   "text": "خل أسألك سؤال."
  },
  {
   "ch": "CH04",
   "s": 3371,
   "e": 3484,
   "text": "لو واحد غيرك سوّى نفس الغلط اللي إنت سويته…"
  },
  {
   "ch": "CH04",
   "s": 3484,
   "e": 3550,
   "text": "راح تقبل منه نفس العذر؟"
  },
  {
   "ch": "CH04",
   "s": 3550,
   "e": 3643,
   "text": "من واحد يجرحك بكلمة، تعتبره قليل احترام."
  },
  {
   "ch": "CH04",
   "s": 3643,
   "e": 3729,
   "text": "بس من إنت تجرحه، تگول چنت معصّب."
  },
  {
   "ch": "CH04",
   "s": 3729,
   "e": 3817,
   "text": "من واحد يسكت عن حقك، تعتبره خذلك."
  },
  {
   "ch": "CH04",
   "s": 3817,
   "e": 3919,
   "text": "بس من إنت تسكت عن حق غيرك، تسميها حكمة."
  },
  {
   "ch": "CH04",
   "s": 3919,
   "e": 3998,
   "text": "من واحد يحچي عليك، تعتبرها إساءة."
  },
  {
   "ch": "CH04",
   "s": 3998,
   "e": 4090,
   "text": "بس من إنت تحچي عليه، تگول مجرد فضفضة."
  },
  {
   "ch": "CH04",
   "s": 4090,
   "e": 4124,
   "text": "نفس الفعل…"
  },
  {
   "ch": "CH04",
   "s": 4124,
   "e": 4205,
   "text": "بس الحكم يختلف، حسب منو اللي سواه."
  },
  {
   "ch": "CH04",
   "s": 4205,
   "e": 4252,
   "text": "القرآن الكريم يگول:"
  },
  {
   "ch": "CH04",
   "s": 4252,
   "e": 4410,
   "text": "كُونُوا قَوَّامِينَ بِالْقِسْطِ شُهَدَاءَ لِلَّهِ وَلَوْ عَلَىٰ أَنفُسِكُمْ."
  },
  {
   "ch": "CH04",
   "s": 4442,
   "e": 4545,
   "text": "فإذا ميزانك يتغيّر كلما صارت القضية تخصّك…"
  },
  {
   "ch": "CH04",
   "s": 4545,
   "e": 4635,
   "text": "شلون راح تعرف إنك فعلاً منصف؟"
  },
  {
   "ch": "CH05",
   "s": 4689,
   "e": 4703,
   "text": "وهنا…"
  },
  {
   "ch": "CH05",
   "s": 4703,
   "e": 4768,
   "text": "تلتفت للقاضي."
  },
  {
   "ch": "CH05",
   "s": 4768,
   "e": 4809,
   "text": "وتباوع للشاهد."
  },
  {
   "ch": "CH05",
   "s": 4809,
   "e": 4861,
   "text": "وترجع تباوع للمتهم."
  },
  {
   "ch": "CH05",
   "s": 4861,
   "e": 4978,
   "text": "وتكتشف الحقيقة اللي چنت تهرب منها من البداية."
  },
  {
   "ch": "CH05",
   "s": 4978,
   "e": 5052,
   "text": "القاضي… إنت."
  },
  {
   "ch": "CH05",
   "s": 5052,
   "e": 5113,
   "text": "والشاهد… إنت."
  },
  {
   "ch": "CH05",
   "s": 5113,
   "e": 5176,
   "text": "والمتهم… هم إنت."
  },
  {
   "ch": "CH05",
   "s": 5176,
   "e": 5255,
   "text": "هاي المحكمة ما چانت بمكان غريب."
  },
  {
   "ch": "CH05",
   "s": 5255,
   "e": 5306,
   "text": "هاي المحكمة بداخلك."
  },
  {
   "ch": "CH05",
   "s": 5306,
   "e": 5450,
   "text": "كل مرة حكمت بيها على غيرك، ورفضت تطبّق نفس الحكم على نفسك."
  },
  {
   "ch": "CH05",
   "s": 5450,
   "e": 5577,
   "text": "كل مرة عرفت بيها غلطك، واخترت تبرّره بدل ما تصلحه."
  },
  {
   "ch": "CH05",
   "s": 5577,
   "e": 5641,
   "text": "بس لحظة الاعتراف بالحقيقة…"
  },
  {
   "ch": "CH05",
   "s": 5641,
   "e": 5693,
   "text": "مو نهاية المحاكمة."
  },
  {
   "ch": "CH05",
   "s": 5693,
   "e": 5764,
   "text": "هي بداية التحرر من سجن الأعذار."
  },
  {
   "ch": "CH06",
   "s": 5848,
   "e": 5918,
   "text": "بس شلون الإنسان يطلع من هاي الدائرة؟"
  },
  {
   "ch": "CH06",
   "s": 5918,
   "e": 6064,
   "text": "شلون يحاسب نفسه، بدون ما يتحول إلى إنسان يائس من نفسه؟"
  },
  {
   "ch": "CH06",
   "s": 6064,
   "e": 6190,
   "text": "الإمام موسى الكاظم، عليه السلام، يرسم إلنا منهج واضح."
  },
  {
   "ch": "CH06",
   "s": 6190,
   "e": 6213,
   "text": "يگول:"
  },
  {
   "ch": "CH06",
   "s": 6213,
   "e": 6566,
   "text": "لَيْسَ مِنَّا مَنْ لَمْ يُحَاسِبْ نَفْسَهُ فِي كُلِّ يَوْمٍ، فَإِنْ عَمِلَ حَسَناً اسْتَزَادَ اللهَ، وَإِنْ عَمِلَ سَيِّئاً اسْتَغْفَرَ اللهَ مِنْهُ وَتَابَ إِلَيْهِ."
  },
  {
   "ch": "CH06",
   "s": 6592,
   "e": 6650,
   "text": "لاحظ دقة هذا المنهج."
  },
  {
   "ch": "CH06",
   "s": 6650,
   "e": 6731,
   "text": "أولاً: المحاسبة كل يوم."
  },
  {
   "ch": "CH06",
   "s": 6731,
   "e": 6833,
   "text": "مو بس من تصير مصيبة، أو من أحد يواجهك بغلطك."
  },
  {
   "ch": "CH06",
   "s": 6833,
   "e": 6984,
   "text": "ثانياً: إذا سويت خير، لا تكتفي بيه. اطلب من الله المزيد."
  },
  {
   "ch": "CH06",
   "s": 6984,
   "e": 7136,
   "text": "وثالثاً: إذا أخطأت، لا تبرّر الخطأ، ولا تيأس من نفسك."
  },
  {
   "ch": "CH06",
   "s": 7136,
   "e": 7229,
   "text": "استغفر الله… وتُب إليه."
  },
  {
   "ch": "CH06",
   "s": 7229,
   "e": 7359,
   "text": "وإذا ظلمت إنسان، حاول تصلح الظلم وترجع الحق لصاحبه."
  },
  {
   "ch": "CH06",
   "s": 7359,
   "e": 7430,
   "text": "المحاسبة مو حتى تكره نفسك."
  },
  {
   "ch": "CH06",
   "s": 7430,
   "e": 7561,
   "text": "المحاسبة حتى تعرف وين أخطأت… وتصلح اللي تگدر تصلحه."
  },
  {
   "ch": "CH07",
   "s": 7613,
   "e": 7671,
   "text": "الليلة، قبل لا تنام…"
  },
  {
   "ch": "CH07",
   "s": 7671,
   "e": 7751,
   "text": "جرّب توقف دقيقة وحدة ويا نفسك."
  },
  {
   "ch": "CH07",
   "s": 7751,
   "e": 7795,
   "text": "منو جرحت اليوم؟"
  },
  {
   "ch": "CH07",
   "s": 7814,
   "e": 7855,
   "text": "أكو حق قصّرت بيه؟"
  },
  {
   "ch": "CH07",
   "s": 7869,
   "e": 7978,
   "text": "أكو غلط بعدك دا تدافع عنه، رغم إنك تعرفه غلط؟"
  },
  {
   "ch": "CH07",
   "s": 7978,
   "e": 8026,
   "text": "لا تبحث عن عذر جديد."
  },
  {
   "ch": "CH07",
   "s": 8026,
   "e": 8098,
   "text": "ابحث عن شي تگدر تصلحه."
  },
  {
   "ch": "CH07",
   "s": 8098,
   "e": 8193,
   "text": "لأن المحكمة اللي بداخلك، مو لازم تبقى سجن إلك."
  },
  {
   "ch": "CH07",
   "s": 8200,
   "e": 8279,
   "text": "ممكن تصير بداية لتغيير حياتك."
  },
  {
   "ch": "CH07",
   "s": 8279,
   "e": 8318,
   "text": "وتذكّر…"
  },
  {
   "ch": "CH07",
   "s": 8318,
   "e": 8380,
   "text": "قبل لا تحاسب غيرك…"
  },
  {
   "ch": "CH07",
   "s": 8380,
   "e": 8424,
   "text": "حاسب نفسك."
  }
 ],
 "outro": {
